+  auto m_ptr = std::make_shared<py::module>(m);
+  m.def(
+      "extend_with",
+      [m_ptr](const std::string &path) {
+        auto pluginOrErr = mlir::triton::plugin::TritonPlugin::load(path);
+        if (!pluginOrErr) {
+          std::string errMsg = llvm::toString(pluginOrErr.takeError());
