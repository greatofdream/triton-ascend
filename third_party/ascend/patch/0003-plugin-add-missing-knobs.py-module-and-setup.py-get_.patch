-    return pluginVersion == TRITON_VERSION;
-
-  // Do partial release version check when TRITON_PLUGIN_VERSION_CHECK unset
-  assert(!doCheck.has_value() && "Expected TRITON_PLUGIN_VERSION_CHECK unset");
